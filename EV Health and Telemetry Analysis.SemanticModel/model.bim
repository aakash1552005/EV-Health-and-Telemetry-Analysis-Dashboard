            "name": "Diagnostic_Risk_Tier",
            "dataType": "string",
            "lineageTag": "d09aaf7a-b059-4828-916e-aae6948e1e2d",
            "sourceColumn": "Diagnostic_Risk_Tier"
          },
          {
            "name": "Mileage Group",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), ev_telemetry_dataset[Mileage_km] <= 35000, \"0\u201335K km\", ev_telemetry_dataset[Mileage_km] <= 75000, \"35K\u201375K km\", ev_telemetry_dataset[Mileage_km] <= 115000, \"75K\u2013115K km\", ev_telemetry_dataset[Mileage_km] <= 150000, \"115K\u2013150K km\", \"150K+ km\")",
            "isDataTypeInferred": true,
            "lineageTag": "ecf85b0d-1d5d-476d-85c8-131dee9b5cea",
            "type": "calculated"
          }
        ],
        "lineageTag": "6903259e-f0cc-49bb-b3ed-66c8e5b721a0",
        "measures": [
          {
            "name": "Total Vehicles",
            "expression": "COUNTROWS(ev_telemetry_dataset)",
            "lineageTag": "06ab3cb3-86cb-4945-ae7e-22f5464d2087"
          },
          {
            "name": "Avg SoH",
            "expression": "AVERAGE(ev_telemetry_dataset[State_of_Health_SoH])",
            "lineageTag": "114f84ad-a83e-4746-820a-b957208e81e9"
          },
          {
            "name": "vs Avg SoH",
            "expression": [
              "VAR _CurrentSoH = AVERAGE(ev_telemetry_dataset[State_of_Health_SoH])",
              "VAR _OverallSoH = CALCULATE(AVERAGE(ev_telemetry_dataset[State_of_Health_SoH]), ALL(ev_telemetry_dataset))",
              "VAR _Diff = _CurrentSoH - _OverallSoH",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    _Diff > 0, UNICHAR(9650) & \" \" & FORMAT(_CurrentSoH, \"0.0\") & \"%\",",
              "    _Diff < 0, UNICHAR(9660) & \" \" & FORMAT(_CurrentSoH, \"0.0\") & \"%\",",
              "    FORMAT(_CurrentSoH, \"0.0\") & \"%\"",
              ")"
            ],
            "lineageTag": "9463c0c2-7018-4d2c-b3ea-08a28f1df140"
          },
          {
            "name": "Avg Efficiency",
            "expression": "FORMAT(AVERAGE(ev_telemetry_dataset[Energy_Efficiency_Wh_km]), \"0\") & \" Wh/km\"",
            "lineageTag": "258f6754-9b10-462c-88c3-b2b73f73ea7e"
          },
          {
            "name": "Critical Alerts",
            "expression": "COALESCE(CALCULATE(COUNTROWS(ev_telemetry_dataset), ev_telemetry_dataset[Diagnostic_Risk_Tier] = \"Critical\"), 0)",
            "lineageTag": "4efe448f-c4b7-4b26-9156-7344f78f40fb"
          },
          {
            "name": "Avg Torque",
            "expression": "AVERAGE(ev_telemetry_dataset[Motor_Torque_Nm])",
            "lineageTag": "7c9aedf7-4ceb-4b42-a6d9-0864dc36ac34"
          },
          {
            "name": "Avg Core Temp",
            "expression": "AVERAGE(ev_telemetry_dataset[Core_Temperature_C])",
            "lineageTag": "4143d0a7-2897-4799-9531-a6909323ca45"
          }
        ],
        "partitions": [
