            "lineageTag": "dc0bd8f1-abc0-44a3-bc21-f1b56055b162",
            "sourceColumn": "Diagnostic_Risk_Tier"
          },
          {
            "name": "Mileage Group",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), ev_telemetry_dataset[Mileage_km] <= 35000, \"0\u201335K km\", ev_telemetry_dataset[Mileage_km] <= 75000, \"35K\u201375K km\", ev_telemetry_dataset[Mileage_km] <= 115000, \"75K\u2013115K km\", ev_telemetry_dataset[Mileage_km] <= 150000, \"115K\u2013150K km\", \"150K+ km\")",
            "isDataTypeInferred": true,
            "lineageTag": "4fc7137d-3d55-46c6-a024-a85cfdb4035e",
            "type": "calculated"
          }
        ],
        "lineageTag": "00a7ce03-0711-447b-967d-6a97f3caa724",
        "measures": [
          {
            "name": "vs Avg SoH",
            "expression": [
              "VAR _CurrentSoH = AVERAGE(ev_telemetry_dataset[State_of_Health_SoH])",
              "VAR _OverallSoH = CALCULATE(AVERAGE(ev_telemetry_dataset[State_of_Health_SoH]), ALL(ev_telemetry_dataset))",
              "VAR _Diff = _CurrentSoH - _OverallSoH",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    _Diff > 0, UNICHAR(9650) & \" \" & FORMAT(_CurrentSoH, \"0.0\") & \"%\",",
              "    _Diff < 0, UNICHAR(9660) & \" \" & FORMAT(_CurrentSoH, \"0.0\") & \"%\",",
              "    FORMAT(_CurrentSoH, \"0.0\") & \"%\"",
              ")"
            ],
            "lineageTag": "2e116f4c-55ce-454d-9d04-3e57e7a6a285"
          },
          {
            "name": "vs Avg Mileage",
            "expression": [
              "VAR _CurrentMileage = AVERAGE(ev_telemetry_dataset[Mileage_km])",
              "VAR _OverallMileage = CALCULATE(AVERAGE(ev_telemetry_dataset[Mileage_km]), ALL(ev_telemetry_dataset))",
              "VAR _Diff = _CurrentMileage - _OverallMileage",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    _Diff > 0, UNICHAR(9650) & \" \" & FORMAT(_CurrentMileage / 1000, \"0.0\") & \"K\",",
              "    _Diff < 0, UNICHAR(9660) & \" \" & FORMAT(_CurrentMileage / 1000, \"0.0\") & \"K\",",
              "    FORMAT(_CurrentMileage / 1000, \"0.0\") & \"K\"",
              ")"
            ],
            "lineageTag": "2531e14b-5cda-44e7-bcc2-405c7dd66f64"
          },
          {
            "name": "Total Vehicles",
            "expression": "COUNTROWS(ev_telemetry_dataset)",
            "lineageTag": "0edd0dbb-4bfc-4c4a-9c31-5864c0f9f5d7"
          },
          {
            "name": "Avg SoH",
            "expression": "AVERAGE(ev_telemetry_dataset[State_of_Health_SoH])",
            "lineageTag": "236f14b6-b94c-45d7-a9a2-f7f45ef83281"
          },
          {
            "name": "Avg Core Temp",
            "expression": "AVERAGE(ev_telemetry_dataset[Core_Temperature_C])",
            "lineageTag": "b4cae975-0b84-40c9-b3d2-8a9f1349d3ce"
          }
        ],
